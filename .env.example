# ============================================================
# ApplyPilot Environment Variables
# Copy this file to .env.local and fill in the values
# ============================================================

# --- App ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-32-char-secret-here

# --- Database (Supabase or Neon PostgreSQL) ---
# Get from: https://supabase.com or https://neon.tech
DATABASE_URL=postgresql://user:password@host:5432/applypilot?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/applypilot?sslmode=require

# --- Google OAuth (for NextAuth + Gmail API) ---
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- AI Provider (set to 'claude' or 'gemini') ---
AI_PROVIDER=claude

# Anthropic Claude (default AI)
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini (alternative)
# Get key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- File Storage ---
# Option A: Vercel Blob (recommended for Vercel deploys)
# Get from: https://vercel.com/dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token-here

# Option B: Supabase Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage provider: 'vercel-blob' or 'supabase'
STORAGE_PROVIDER=vercel-blob

# --- Encryption (for Gmail tokens) ---
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=your-32-byte-base64-encoded-key-here

# --- Gmail API (OAuth tokens stored in DB, but client needed) ---
# Same as GOOGLE_CLIENT_ID/SECRET above, also used for Gmail send
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# --- Resend (fallback email sender) ---
# Get key: https://resend.com
RESEND_API_KEY=re_your-resend-key-here
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Job Discovery APIs ---
# Adzuna: https://developer.adzuna.com
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_API_KEY=your-adzuna-api-key

# Jooble: https://jooble.org/api/about
JOOBLE_API_KEY=your-jooble-api-key

# Remotive & Arbeitnow: free, no key needed
# RemoteOK: free, no key needed

# --- Background Jobs: Inngest ---
# Get keys: https://www.inngest.com
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# --- Monitoring: Sentry ---
# Create project: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@o123456.ingest.sentry.io/123456
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=applypilot
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# --- Rate Limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- App Settings ---
DEFAULT_DAILY_SEND_LIMIT=10
MAX_DAILY_SEND_LIMIT=25
FOLLOWUP_DAYS_DEFAULT=5
DUPLICATE_WINDOW_DAYS=30
MAX_FILE_SIZE_MB=10

# --- Cron Job Secret (to protect cron endpoints) ---
CRON_SECRET=your-random-cron-secret-here
